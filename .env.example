NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/converse?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-random-value-at-least-32-characters-long
CLIENT_ORIGIN=http://localhost:5173
IMAGE_STORAGE_DRIVER=local
IMAGE_MAX_UPLOAD_BYTES=5242880
IMAGE_LOCAL_STORAGE_DIR=.data/images
IMAGE_SIGNED_URL_TTL_SECONDS=300
AVATAR_MAX_UPLOAD_BYTES=5242880
AVATAR_STORAGE_DIR=backend/uploads/avatars
# Required only when IMAGE_STORAGE_DRIVER=s3 (AWS S3 or S3-compatible providers such as R2)
# S3_BUCKET=your-private-bucket-name
# S3_REGION=us-east-1
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=backend-only-access-key
# S3_SECRET_ACCESS_KEY=backend-only-secret-key
