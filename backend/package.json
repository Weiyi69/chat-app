{
  "name": "@private-chat/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "argon2": "^0.44.0",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "csrf-sync": "^4.2.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.2",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.8.1",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^5.0.5"
  }
}
